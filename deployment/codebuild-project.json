{
  "name": "audittrail-ai-build",
  "description": "Build AuditTrail AI in CodeBuild and push its image to ECR",
  "source": {
    "type": "GITHUB",
    "location": "https://github.com/Veeravelly1936/audittrail-ai.git",
    "buildspec": "buildspec.yml",
    "gitCloneDepth": 1
  },
  "sourceVersion": "main",
  "artifacts": {
    "type": "NO_ARTIFACTS"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "image": "aws/codebuild/standard:7.0",
    "computeType": "BUILD_GENERAL1_SMALL",
    "privilegedMode": true,
    "imagePullCredentialsType": "CODEBUILD",
    "environmentVariables": [
      {
        "name": "IMAGE_REPO_NAME",
        "value": "audittrail-ai",
        "type": "PLAINTEXT"
      }
    ]
  },
  "serviceRole": "arn:aws:iam::404107359700:role/AuditTrailCodeBuildRole",
  "timeoutInMinutes": 30,
  "queuedTimeoutInMinutes": 60,
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED",
      "groupName": "/aws/codebuild/audittrail-ai"
    },
    "s3Logs": {
      "status": "DISABLED"
    }
  }
}